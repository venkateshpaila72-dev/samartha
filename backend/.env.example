# FarmShield Backend Configuration Example
# Copy this file to .env and provide your credentials.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# MongoDB Connection (Local or Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/farmshield_db
MONGODB_DATABASE=farmshield_db

# Authentication / Security
JWT_SECRET_KEY=replace_with_a_secure_random_hex_key_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & Traditional Knowledge (Pinecone Vector DB)
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=sar
PINECONE_API_KEY=your_pinecone_api_key_here

# Microsoft Azure Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastasia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/

# Microsoft Azure Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastasia

# Weather API (Open-Meteo - No API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Agricultural Market Price API (AGMARKNET)
AGMARKNET_BASE_URL=https://api.agmarknet.gov.in/v1

# WhatsApp Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Media & Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
