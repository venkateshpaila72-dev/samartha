# Create a safe example configuration
@'
# FarmShield Backend Configuration

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=farmshield_db

# Authentication - replace for local development
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Retrieval Augmented Generation
RAG_PROVIDER=in_memory_vector
RAG_COLLECTION=traditional_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Azure Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=eastus

# Azure Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Weather API
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Agricultural Market API
MARKET_API_KEY=your_market_api_key_here
MARKET_API_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# WhatsApp
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=your_whatsapp_bearer_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# File Storage
STORAGE_PROVIDER=local
STORAGE_UPLOAD_DIR=./uploads
