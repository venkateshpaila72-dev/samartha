# FarmShield Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEFAULT_LANGUAGE=en
VITE_APP_TITLE=FarmShield
# WhatsApp opt-in QR: use the exact sender number and join keyword shown in Twilio.
# Example number format: international digits only, no +, spaces, or punctuation.
# Do not guess the keyword; for the Twilio Sandbox use the join phrase assigned to your account.
VITE_WHATSAPP_OPT_IN_NUMBER=
VITE_WHATSAPP_JOIN_KEYWORD=
